# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma
DATABASE_URL=
DIRECT_URL=

# Email (optionnel — envoi des rapports propriétaire)
RESEND_API_KEY=

# Cron (obligatoire pour activer les tâches planifiées : sync iCal, dépenses récurrentes)
# Vercel Cron envoie automatiquement "Authorization: Bearer <CRON_SECRET>".
# Sans cette variable, les endpoints /api/cron/* sont désactivés (503).
CRON_SECRET=
